[Unit]
Description=GPU Share — NVENC Encoding Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=godunder
Group=aiusers
SupplementaryGroups=video render
WorkingDirectory=/opt/gpu-share
ExecStart=/opt/gpu-share/venv/bin/python -m gpu_share.server
Restart=on-failure
RestartSec=5

# Hardening
ProtectSystem=strict
ReadWritePaths=/tmp/gpu_share_hls
NoNewPrivileges=true
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
